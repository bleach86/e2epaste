{% extends "layout" %}
{% import "icons" as icons %}

{% block page %}
<div class="page page-narrow">
    <div class="panel panel-pad text-center not-found">
        <span class="dialog-badge mx-auto mb-3">{{ icons.icon("alert") }}</span>
        <h1 class="h3 fw-bold">Paste not found</h1>
        <p class="text-body-secondary mb-4">This paste doesn't exist, has expired, or has reached its view limit.
            Expired and burned pastes are deleted for good, so they can't be recovered.</p>
        <a href="/" class="btn btn-accent">{{ icons.icon("plus") }} Create a new paste</a>
    </div>
</div>
{% endblock %}
