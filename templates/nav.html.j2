{# nav_tools (every tool, grouped by hub) is a global set in main.rs. The
   current section is worked out from page.canonical. #}
{% set path = page.canonical or "" %}
<nav class="navbar fixed-top bg-dark-subtle navbar-expand-lg pt-2">
  <div class="container-fluid container-lg">
    <a class="navbar-brand" href="/">{{ title }}</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link{% if path == '/' %} active{% endif %}" {% if path == '/' %}aria-current="page" {% endif %}href="/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link{% if path == '/faq' %} active{% endif %}" {% if path == '/faq' %}aria-current="page" {% endif %}href="/faq">FAQ</a>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle{% if path is startingwith('/tools') %} active{% endif %}" href="#"
            role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Tools
          </a>
          <div class="dropdown-menu tools-menu">
            {% for listing in nav_tools %}
            <div class="tools-menu-group">
              <a class="dropdown-item tools-menu-heading" href="{{ listing.hub.path }}">{{ listing.hub.name }}</a>
              {% for t in listing.tools %}
              {% set current = path == '/tools/' ~ t.slug %}
              <a class="dropdown-item{% if current %} active{% endif %}" {% if current %}aria-current="page" {% endif %}href="/tools/{{ t.slug }}">{{ t.name }}</a>
              {% endfor %}
            </div>
            {% endfor %}
          </div>
        </li>
      </ul>
      <span class="navbar-text ms-auto" style="font-size: small;">
        Fully End-to-End Encrypted Pastebin
      </span>
    </div>
  </div>
</nav>
