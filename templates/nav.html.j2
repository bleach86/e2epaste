{# nav_tools (every tool, grouped by hub) is a global set in main.rs. The
   current section is worked out from page.canonical. #}
{% import "icons" as icons %}
{% set path = page.canonical or "" %}
<header class="site-header sticky-top">
  <nav class="navbar navbar-expand-lg" aria-label="Main">
    <a class="brand me-4" href="/">
      <span class="brand-mark">{{ icons.icon("lock") }}</span>
      <span>{{ brand }}{% if brand_suffix %}<span class="brand-suffix">{{ brand_suffix }}</span>{% endif %}</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav gap-lg-2">
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle{% if path is startingwith('/tools') %} active{% endif %}" href="#"
            role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Tools
          </a>
          <div class="dropdown-menu tools-menu">
            {% for listing in nav_tools %}
            <div class="tools-menu-group">
              <a class="dropdown-item tools-menu-heading" href="{{ listing.hub.path }}">{{ listing.hub.name }}</a>
              {% for t in listing.tools %}
              {% set current = path == '/tools/' ~ t.slug %}
              <a class="dropdown-item{% if current %} active{% endif %}" {% if current %}aria-current="page" {% endif %}href="/tools/{{ t.slug }}">{{ t.name }}</a>
              {% endfor %}
            </div>
            {% endfor %}
          </div>
        </li>
        <li class="nav-item">
          <a class="nav-link{% if path == '/faq' %} active{% endif %}" {% if path == '/faq' %}aria-current="page" {% endif %}href="/faq">FAQ</a>
        </li>
      </ul>
      <div class="d-flex align-items-center gap-3 ms-lg-auto mt-2 mt-lg-0 pb-2 pb-lg-0">
        <a class="nav-link d-inline-flex align-items-center gap-2" href="{{ source_url }}" target="_blank" rel="noopener noreferrer">
          {{ icons.icon("github" if "github.com" in source_url else "code") }} Open source
        </a>
        {% if path != '/' %}
        <a class="btn btn-accent btn-sm" href="/">{{ icons.icon("plus") }} New paste</a>
        {% endif %}
      </div>
    </div>
  </nav>
</header>
