{% extends "layout" %}
{% import "icons" as icons %}
{% import "agent_hint" as agent_hint %}

{% block head %}{{ agent_hint.head() }}{% endblock %}

{% block page %}
{{ agent_hint.notice() }}
<div class="page">
    <div id="decrypted-notice" class="notice mb-3" hidden>
        {{ icons.icon("shield-check") }}
        <span>Decrypted in your browser. The server only ever had the encrypted version.</span>
    </div>
    <div id="decrypt-error" class="notice notice-danger mb-3" role="alert" hidden>
        {{ icons.icon("alert") }}
        <span>This paste couldn't be decrypted. Check that you have the complete link, including everything after
            the <code>#</code>.</span>
    </div>
    <div id="open-error" class="notice notice-danger mb-3" role="alert" hidden>
        {{ icons.icon("alert") }}
        <span id="open-error-text"></span>
    </div>
    {# For the paste's creator (this browser has its delete token), when
       opening it would use up a limited view or start its timer. #}
    <section id="owner-prompt" class="panel panel-pad mb-3" aria-labelledby="owner-prompt-title" hidden>
        <h2 class="h5 fw-bold mb-1" id="owner-prompt-title">You created this paste</h2>
        <p class="text-secondary mb-3" id="owner-prompt-text"></p>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" id="owner-open-btn" class="btn btn-accent d-inline-flex align-items-center gap-2">
                {{ icons.icon("eye") }} Open it</button>
            <a id="owner-delete-link" class="btn btn-quiet btn-quiet-danger">{{ icons.icon("eraser") }} Delete it</a>
        </div>
    </section>

    <div class="paste-head">
        <div class="min-w-0">
            {# v3 titles are encrypted; js/pages/paste.mjs fills them in after decrypting. #}
            <h1 class="page-title paste-title" id="paste-title">{% if paste.version < 3 %}{{ paste.title }}{% else %}Encrypted paste{% endif %}</h1>
            <ul class="chips mt-2" aria-label="Paste details">
                <li class="chip" id="language-chip">{{ icons.icon("code") }} <span id="language-name">{{ formatted_lang }}</span></li>
                <li class="chip">Created <span id="paste-date"></span></li>
                <li class="chip">{{ icons.icon("clock") }} <span id="expire-date"></span></li>
                <li class="chip">{{ icons.icon("eye") }} <span id="views"></span></li>
                <li class="chip chip-warn" id="timer-chip" hidden>{{ icons.icon("clock") }} <span id="timer-text"></span></li>
                <li class="chip chip-warn" id="final-view" hidden>{{ icons.icon("flame") }} Final view: it can't be opened again</li>
            </ul>
        </div>
        <div class="paste-actions">
            {# Markdown pastes only. #}
            <div class="seg-toggle" id="markdown-toggle" role="group" aria-label="Show Markdown as" hidden>
                <button type="button" class="btn btn-quiet" data-view="rendered" aria-pressed="false">Rendered</button>
                <button type="button" class="btn btn-quiet" data-view="source" aria-pressed="true">Source</button>
            </div>
            <button type="button" id="copy-paste-btn" class="btn btn-quiet" disabled>
                <span class="copy-idle d-inline-flex align-items-center gap-2">{{ icons.icon("copy") }} Copy</span>
                <span class="copy-done d-none align-items-center gap-2">{{ icons.icon("check") }} Copied</span>
            </button>
            <button type="button" id="download-paste-btn" class="btn btn-quiet" disabled>{{ icons.icon("download") }} Download</button>
            <button type="button" id="wrap-btn" class="btn btn-quiet" aria-pressed="false" aria-label="Wrap long lines"
                title="Wrap long lines">{{ icons.icon("wrap") }}</button>
            {# Only in the browser that created the paste (js/delete_tokens.mjs). #}
            <a id="delete-paste-btn" class="btn btn-quiet btn-quiet-danger" hidden>{{ icons.icon("eraser") }} Delete</a>
        </div>
    </div>

    {# Hidden for a paste that's just an attachment. #}
    <section class="panel mt-3" id="content-panel" aria-label="Paste content">
        <div class="code-view" id="code-view">
            <pre class="code-gutter" id="code-gutter" aria-hidden="true"></pre>
            <pre class="code-body"><code id="view-area"></code></pre>
        </div>
        {# Sanitized HTML from js/markdown.mjs. #}
        <div class="markdown-body" id="markdown-view" hidden></div>
    </section>

    <section id="attachment-section" class="panel attachment-panel mt-3" aria-label="Attachment" hidden>
        <span class="attachment-icon">{{ icons.icon("file") }}</span>
        <div class="min-w-0 flex-grow-1">
            <div id="attachment-name" class="fw-semibold text-truncate"></div>
            <div id="download-status" class="small text-secondary">Encrypted attachment</div>
        </div>
        <button type="button" id="download-link" class="btn btn-quiet btn-outline-accent">
            <span class="dl-idle d-inline-flex align-items-center gap-2">{{ icons.icon("download") }} Decrypt &amp; download</span>
            <span class="dl-busy d-none align-items-center gap-2"><span class="spinner-border spinner-border-sm"
                    aria-hidden="true"></span> Working...</span>
        </button>
    </section>
</div>

<button type="button" class="btn btn-quiet" id="btn-back-to-top" aria-label="Back to top">
    {{ icons.icon("arrow-up") }}
</button>

<div class="modal fade" id="password-modal" data-bs-backdrop="static" tabindex="-1"
    aria-labelledby="password-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered link-dialog">
        <div class="modal-content">
            <div class="d-flex align-items-start gap-3">
                <span class="dialog-badge">{{ icons.icon("lock") }}</span>
                <div>
                    <h2 id="password-modal-title" class="h5 fw-bold mb-0">This paste is password protected</h2>
                    <p class="mb-0 small text-secondary">Enter the password to decrypt it. The password itself
                        never leaves your browser.</p>
                </div>
            </div>

            <div>
                <label for="password-input" class="field-label">Password</label>
                <div class="input-group">
                    <input type="password" class="form-control" id="password-input" autocomplete="new-password"
                        spellcheck="false" aria-describedby="password-error" data-1p-ignore data-lpignore="true" data-bwignore="true" data-form-type="other">
                    <button class="btn btn-quiet" type="button" id="show-pass-button" aria-label="Show password"
                        aria-pressed="false">
                        <span class="pw-show d-inline-flex">{{ icons.icon("eye") }}</span>
                        <span class="pw-hide d-none">{{ icons.icon("eye-off") }}</span>
                    </button>
                </div>
                <div id="password-error" class="field-hint text-danger" role="alert" hidden>That password didn't work.
                    Check it and try again.</div>
            </div>

            <div class="d-flex justify-content-between align-items-center gap-3">
                <div class="d-flex flex-wrap gap-3">
                    <a class="small" href="/">Go to the home page</a>
                    <a class="small text-danger" id="password-delete-link" hidden>Delete this paste</a>
                </div>
                <button id="submit-password-btn" type="button" class="btn btn-accent">
                    <span class="unlock-idle d-inline-flex align-items-center gap-2">{{ icons.icon("lock") }} Unlock</span>
                    <span class="unlock-busy d-none align-items-center gap-2"><span
                            class="spinner-border spinner-border-sm" aria-hidden="true"></span> Checking...</span>
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script type="application/json" id="page-data">{{ {"paste": paste} | tojson }}</script>
<script src="/public/js/dist/paste.js?v={{ asset_version }}"></script>
{% endblock %}
