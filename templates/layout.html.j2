<!doctype html>
{% import "icons" as icons %}
<html data-bs-theme="dark" lang="en-US">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {# Page titles and descriptions say "{site}" where the site's name goes. #}
    {% set page_title = page.title | replace("{site}", site_name) %}
    {% set page_description = page.description | replace("{site}", site_name) %}
    <title>{{ page_title }}</title>
    <meta name="description" content="{{ page_description }}">
    {# site_url and page.canonical are constants from main.rs, so |safe is fine #}
    {% if page.canonical %}
    <link rel="canonical" href="{{ site_url|safe }}{{ page.canonical|safe }}">
    <meta property="og:url" content="{{ site_url|safe }}{{ page.canonical|safe }}">
    {% else %}
    <meta name="robots" content="noindex, nofollow">
    {% endif %}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site_name }}">
    <meta property="og:title" content="{{ page_title }}">
    <meta property="og:description" content="{{ page_description }}">
    <meta property="og:image" content="{{ site_url|safe }}/public/android-chrome-512x512.png">
    <meta property="og:image:width" content="512">
    <meta property="og:image:height" content="512">
    <meta property="og:image:alt" content="{{ site_name }} logo">
    <meta name="twitter:card" content="summary">
    <link rel="apple-touch-icon" sizes="180x180" href="/public/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/public/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/public/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#0e1116">
    {% block head %}{% endblock %}

    <link rel="preload" href="/public/fonts/metropolis-latin-400.woff2" as="font" type="font/woff2" crossorigin>
    <link href="/public/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/public/css/atom-one-dark.min.css">
    {# Last, so the theme overrides Bootstrap. #}
    <link rel="stylesheet" href="/public/css/styles.css?v=2.12">
</head>

<body class="d-flex flex-column min-vh-100">
    <a href="#main" class="visually-hidden-focusable position-absolute top-0 start-0 m-2 btn btn-accent skip-link">Skip to content</a>
    {% include "nav" %}
    {# Shown by common.mjs when the page isn't a secure context (plain HTTP),
       where browsers turn off the Web Crypto API. #}
    <div id="insecure-warning" class="insecure-warning" role="alert" hidden>
        <div class="insecure-warning-inner">
            {{ icons.icon("alert") }}
            <div>
                <p class="mb-1"><strong>Encryption doesn't work on this connection.</strong> This page wasn't loaded
                    over HTTPS, and browsers only allow the encryption {{ site_name }} uses on secure pages. You can't
                    create or open pastes until you use the HTTPS address.</p>
                <a id="insecure-https-link" class="btn btn-sm btn-warn mt-1 mb-2" hidden>Open this page over HTTPS</a>
                <p class="insecure-warning-admin mb-0">Running this site? Put it behind HTTPS, or use
                    <code>http://localhost</code> while testing.</p>
            </div>
        </div>
    </div>
    <main id="main" class="flex-grow-1">
        {% block page %}{% endblock %}
    </main>
    {% include "footer" %}

    <script src="/public/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/public/js/dist/common.js?v={{ asset_version }}"></script>
    {% block scripts %}{% endblock %}
</body>

</html>