{% extends "layout" %}
{% import "icons" as icons %}

{# Base for templates/tools/<slug>: fill `tool` with the widget and `about`
   with the explanatory text. Loads /public/js/dist/tools/<slug>.js. #}

{% block page %}
<div class="page">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small mb-3">
            <li class="breadcrumb-item"><a href="/" class="link-secondary">Home</a></li>
            <li class="breadcrumb-item"><a href="{{ hub.path }}" class="link-secondary">{{ hub.name }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ tool.name }}</li>
        </ol>
    </nav>

    <h1 class="page-title">{{ tool.name }}</h1>
    <p class="page-lede">{{ tool.summary }}</p>
    <p class="small text-secondary d-flex align-items-center gap-2 mt-2 mb-4">
        <span class="text-accent d-inline-flex">{{ icons.icon("shield") }}</span>
        Runs entirely in your browser. Nothing you enter is sent to the server.
    </p>

    {% block tool %}{% endblock %}

    <article class="tool-about mt-5">
        {% block about %}{% endblock %}
    </article>

    {% include "tool_list" %}
</div>

<button type="button" class="btn btn-quiet" id="btn-back-to-top" aria-label="Back to top">
    {{ icons.icon("arrow-up") }}
</button>
{% endblock %}

{% block scripts %}
<script src="/public/js/dist/tools/{{ tool.slug }}.js?v={{ asset_version }}"></script>
{% endblock %}
