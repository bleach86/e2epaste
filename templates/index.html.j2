{% extends "layout" %}
{% import "icons" as icons %}

{% set expiries = [["10min", "10 min"], ["1hour", "1 hour"], ["1day", "1 day"], ["3days", "3 days"],
["1week", "1 week"], ["2weeks", "2 weeks"], ["1month", "1 month"], ["6months", "6 months"],
["1year", "1 year"]] %}

{% block page %}
<div class="page create-page">
    <div class="mb-4">
        <h1 class="page-title">Share text and files, end-to-end encrypted.</h1>
        <p class="page-lede">Everything is encrypted in your browser before upload. The server never sees the key
            or your content.</p>
    </div>

    <div class="create-layout">
        <section class="panel create-editor" aria-label="Paste">
            {# Shown while files are dragged over the page (js/pages/create.mjs) #}
            <div id="drop-overlay" class="drop-overlay" hidden>
                {% if limits.max_file_bytes %}
                {{ icons.icon("paperclip") }}
                <span>Drop to attach</span>
                <span class="small text-secondary">One file or several, up to {{ limits.max_file_label }}</span>
                {% else %}
                <span>This site doesn't take files</span>
                {% endif %}
            </div>
            <div class="panel-bar">
                <label for="paste-title" class="visually-hidden">Title</label>
                <input id="paste-title" class="title-input" type="text" maxlength="64" placeholder="Title (optional)"
                    autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore="true" data-form-type="other">
                <label for="syntax" class="visually-hidden">Syntax highlighting</label>
                <select id="syntax" class="form-select form-select-sm w-auto">
                    {# Guessed in the browser; the server only stores "auto". #}
                    <option value="auto" selected>Auto-detect</option>
                    <option value="plaintext">Plain text</option>
                    <optgroup label="Syntax highlighting">
                        {% for language in languages if language[0] not in ["plaintext", "auto"] %}
                        <option value="{{ language[0] }}">{{ language[1] }}</option>
                        {% endfor %}
                    </optgroup>
                </select>
                {% if limits.max_file_bytes %}
                <input type="file" id="fileInput" class="visually-hidden file-input" multiple>
                <label for="fileInput" class="btn btn-quiet btn-sm file-pick">{{ icons.icon("paperclip") }} Attach
                    files</label>
                {% endif %}
            </div>
            {% if limits.max_file_bytes %}
            <div id="attachment" class="attachment-row" hidden>
                {{ icons.icon("file") }}
                <span id="attachment-name" class="text-truncate"></span>
                <span id="attachment-size" class="text-secondary"></span>
                <button type="button" id="attachment-remove" class="btn btn-link btn-sm ms-auto p-0 text-secondary"
                    aria-label="Remove attachment">{{ icons.icon("x") }}</button>
            </div>
            {% endif %}

            <div id="paste-editor" class="paste-editor">
                <pre class="paste-highlight" aria-hidden="true"><code id="paste-highlight" class="hljs"></code></pre>
                <label for="paste-area" class="visually-hidden">Paste content</label>
                <textarea id="paste-area"
                    placeholder="{% if limits.max_file_bytes %}Paste or type here, or just attach files...{% else %}Paste or type here...{% endif %}"
                    spellcheck="false" aria-describedby="paste-area-keys"></textarea>
                {# js/editor_keys.mjs #}
                <span id="paste-area-keys" class="visually-hidden">Tab inserts a tab. To move on, press Escape, then
                    Tab.</span>
            </div>
            <div class="panel-foot">
                <span id="paste-stats">0 lines · 0 bytes</span>
                <span>Up to {{ limits.max_paste_label }} of text{% if limits.max_file_label %} · files up to
                    {{ limits.max_file_label }}{% endif %}</span>
            </div>
        </section>

        <aside class="panel panel-pad create-options" aria-label="Options">
            <fieldset>
                <legend class="field-label">Expires after</legend>
                <div class="seg">
                    {% for value, label in expiries %}
                    <input type="radio" class="btn-check" name="expire" id="expire-{{ value }}" value="{{ value }}" {%
                        if value=="3days" %}checked{% endif %}>
                    <label class="seg-btn" for="expire-{{ value }}">{{ label }}</label>
                    {% endfor %}
                </div>
            </fieldset>

            <hr class="panel-divider">

            <div class="d-flex justify-content-between align-items-center gap-3">
                <div>
                    <label for="burn" class="field-label d-flex align-items-center gap-2 mb-0">
                        <span class="text-warn d-inline-flex">{{ icons.icon("flame") }}</span> Burn after reading
                    </label>
                    <div class="field-hint mt-0">Delete after the first view</div>
                </div>
                <div class="form-check form-switch m-0">
                    <input class="form-check-input switch-lg" type="checkbox" role="switch" id="burn">
                </div>
            </div>

            <div>
                <label for="max-views" class="field-label">Or limit views</label>
                <input type="number" id="max-views" class="form-control" min="0" max="999999999999" inputmode="numeric"
                    placeholder="Unlimited">
            </div>

            <div>
                <label for="delete-after-open" class="field-label">After it's first opened</label>
                <select id="delete-after-open" class="form-select">
                    <option value="" selected>Keep it until it expires</option>
                    <option value="600" data-chip="Deleted 10 minutes after opening">Delete it 10 minutes later</option>
                    <option value="3600" data-chip="Deleted 1 hour after opening">Delete it 1 hour later</option>
                    <option value="86400" data-chip="Deleted 1 day after opening">Delete it 1 day later</option>
                </select>
                <div class="field-hint">Gives the reader time to read or download it, then it's gone.</div>
            </div>

            <hr class="panel-divider">

            <div>
                <label for="paste-password" class="field-label">Password <span
                        class="fw-normal text-secondary">(optional)</span></label>
                <div class="input-group">
                    <input type="password" id="paste-password" class="form-control" autocomplete="new-password"
                        spellcheck="false" data-1p-ignore data-lpignore="true" data-bwignore="true"
                        data-form-type="other">
                    <button type="button" id="toggle-password" class="btn btn-quiet" aria-label="Show password"
                        aria-pressed="false">{{ icons.icon("eye") }}</button>
                </div>
                <div class="field-hint">Needed to open the paste, even with the link.</div>
            </div>

            <hr class="panel-divider">

            {# js/delete_tokens.mjs #}
            <div class="d-flex justify-content-between align-items-center gap-3">
                <div>
                    <label for="remember-delete" class="field-label mb-0">Remember on this device</label>
                    <div class="field-hint mt-0">So this browser can delete it later</div>
                </div>
                <div class="form-check form-switch m-0">
                    <input class="form-check-input switch-lg" type="checkbox" role="switch" id="remember-delete"
                        checked>
                </div>
            </div>

            <button type="button" id="submit-paste" class="btn btn-accent btn-lg w-100">
                <span class="submit-idle d-inline-flex align-items-center gap-2">{{ icons.icon("lock") }} Encrypt &amp;
                    get link</span>
                <span class="submit-busy d-none align-items-center gap-2"><span class="spinner-border spinner-border-sm"
                        aria-hidden="true"></span> <span id="submit-status" role="status" aria-live="polite">Encrypting...</span></span>
            </button>
        </aside>
    </div>

    <ul class="trust-list">
        <li>{{ icons.icon("shield") }}<div><strong>Encrypted in your browser</strong><span>AES-256-GCM via the Web
                    Crypto API.</span></div>
        </li>
        <li>{{ icons.icon("link") }}<div><strong>The key stays in the link</strong><span>After the #, which browsers
                    never send to the server.</span></div>
        </li>
        <li>{{ icons.icon("code") }}<div><strong>Open source</strong><span>Check <a href="{{ source_url }}"
                        target="_blank" rel="noopener noreferrer">the code</a> yourself.</span></div>
        </li>
    </ul>
</div>

<div class="modal fade" id="url-modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="url-modal-title"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered link-dialog">
        <div class="modal-content">
            <div class="d-flex align-items-start gap-3">
                <span class="dialog-badge">{{ icons.icon("check") }}</span>
                <div class="flex-grow-1">
                    <h2 id="url-modal-title" class="h5 fw-bold mb-0">Your encrypted link is ready</h2>
                    <p class="mb-0 small text-secondary">Anyone with this link can read the paste.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div>
                <label for="paste-url" class="field-label">Link</label>
                <div class="input-group">
                    <input id="paste-url" class="form-control font-monospace small" type="text" readonly>
                    <button id="copy-url-btn" type="button" class="btn btn-accent">
                        <span class="copy-idle d-inline-flex align-items-center gap-2">{{ icons.icon("copy") }}
                            Copy</span>
                        <span class="copy-done d-none align-items-center gap-2">{{ icons.icon("check") }} Copied</span>
                    </button>
                </div>
            </div>

            <ul id="link-summary" class="chips" aria-label="Paste settings"></ul>

            {# The paste was created but its attachment didn't upload (js/pages/create.mjs). #}
            <div id="upload-failed" class="notice notice-danger" role="alert" hidden>
                {{ icons.icon("alert") }}
                <p class="mb-0">The attachment couldn't be uploaded, so the paste has only the text. Anyone opening it
                    will see the attachment but won't be able to download it. You can delete the paste with the delete
                    link below and try again.</p>
            </div>

            <div class="notice notice-plain">
                {{ icons.icon("info") }}
                <p id="link-tip" class="mb-0"></p>
            </div>

            <details class="qr-details">
                <summary>Show QR code</summary>
                <div id="qrcode-container" class="qr-box"></div>
            </details>

            <details class="qr-details delete-details">
                <summary>Delete link</summary>
                <p class="small text-secondary mt-2 mb-2">Opens a page where you can delete the paste before it
                    expires. Keep it to yourself: anyone with it can delete the paste. It's only shown now<span
                        id="delete-remembered">, but this browser also remembers it, so the paste's page has a Delete
                        button for you here</span>.</p>
                <div class="input-group">
                    <input id="delete-url" class="form-control font-monospace small" type="text" readonly
                        aria-label="Delete link">
                    <button id="copy-delete-btn" type="button" class="btn btn-quiet">
                        <span class="copy-idle d-inline-flex align-items-center gap-2">{{ icons.icon("copy") }}
                            Copy</span>
                        <span class="copy-done d-none align-items-center gap-2">{{ icons.icon("check") }} Copied</span>
                    </button>
                </div>
            </details>

            <div class="d-flex justify-content-end">
                <button type="button" class="btn btn-quiet" data-bs-dismiss="modal">Create another paste</button>
            </div>
        </div>
    </div>
</div>

{# Icons the script copies into the link summary chips. #}
<template id="chip-icons">
    <span data-icon="clock">{{ icons.icon("clock") }}</span>
    <span data-icon="flame">{{ icons.icon("flame") }}</span>
    <span data-icon="eye">{{ icons.icon("eye") }}</span>
    <span data-icon="lock">{{ icons.icon("lock") }}</span>
    <span data-icon="paperclip">{{ icons.icon("paperclip") }}</span>
</template>

<button type="button" class="btn btn-quiet" id="btn-back-to-top" aria-label="Back to top">
    {{ icons.icon("arrow-up") }}
</button>
{% endblock %}

{% block scripts %}
<script type="application/json" id="page-data">{{ {"limits": limits} | tojson }}</script>
<script src="/public/js/dist/create.js?v={{ asset_version }}"></script>
{% endblock %}