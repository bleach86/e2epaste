{% extends "layout" %}

{# One row: project name (linked), what it's used for, licence, copyright. #}
{% macro row(name, url, use, licence, copyright) %}
<tr>
    <td><a href="{{ url }}" target="_blank" rel="noopener noreferrer">{{ name }}</a></td>
    <td>{{ use }}</td>
    <td class="text-nowrap">{{ licence }}</td>
    <td class="text-body-secondary small">{{ copyright }}</td>
</tr>
{% endmacro %}

{% block page %}
<div class="page page-narrow credits">
    <h1 class="page-title">Open source credits</h1>
    <p class="page-lede">{{ site_name }} is built on open source software. Thank you to everyone who makes and
        maintains these projects.</p>
    <p class="text-body-secondary">The code behind this site is open source too, under the MIT licence:
        <a href="{{ source_url }}" target="_blank" rel="noopener noreferrer">source code</a>.</p>

    <section class="mt-5" aria-labelledby="credits-browser">
        <h2 class="h4" id="credits-browser">In your browser</h2>
        <p class="text-body-secondary">Sent to your browser as part of the site.</p>
        <div class="table-responsive panel">
            <table class="table credits-table mb-0">
                <thead>
                    <tr><th scope="col">Project</th><th scope="col">Used for</th><th scope="col">Licence</th><th scope="col">Copyright</th></tr>
                </thead>
                <tbody>
                    {{ row("Bootstrap 5.3", "https://getbootstrap.com/", "Layout and components", "MIT",
                        "© 2011–2025 The Bootstrap Authors") }}
                    {{ row("Popper", "https://popper.js.org/", "Positioning Bootstrap's menus and popovers", "MIT",
                        "© 2019 Federico Zivolo") }}
                    {{ row("highlight.js 11.12", "https://highlightjs.org/", "Syntax highlighting, including the Atom One Dark theme", "BSD-3-Clause",
                        "© 2006 Ivan Sagalaev; Josh Goebel and other contributors") }}
                    {{ row("marked 18", "https://marked.js.org/", "Rendering Markdown pastes", "MIT",
                        "© 2018+ MarkedJS; © 2011–2018 Christopher Jeffrey") }}
                    {{ row("DOMPurify 3", "https://github.com/cure53/DOMPurify", "Making rendered Markdown safe to show", "Apache-2.0 (or MPL-2.0)",
                        "© Cure53 and other contributors") }}
                    {{ row("pako 3.0", "https://github.com/nodeca/pako", "Compressing pastes before encryption", "MIT and Zlib",
                        "© 2014–2017 Vitaly Puzrin and Andrei Tuputcyn; zlib © Jean-loup Gailly and Mark Adler") }}
                    {{ row("zxcvbn-ts", "https://github.com/zxcvbn-ts/zxcvbn", "Password strength checker and its word lists", "MIT",
                        "© 2012–2016 Dan Wheeler and Dropbox, Inc.; © 2021 @zxcvbn-ts") }}
                    {{ row("noble-hashes 2.4", "https://github.com/paulmillr/noble-hashes", "MD5, SHA, SHA-3, BLAKE3 and HMAC in the hash generator", "MIT",
                        "© 2022 Paul Miller") }}
                    {{ row("QR Code Generator 2.0", "https://github.com/kazuhikoarase/qrcode-generator", "QR codes for paste links", "MIT",
                        "© 2009 Kazuhiko Arase") }}
                    {{ row("Metropolis", "https://github.com/chrismsimpson/Metropolis", "Interface font", "Public domain (Unlicense)",
                        "Chris Simpson") }}
                    {{ row("JetBrains Mono", "https://www.jetbrains.com/lp/mono/", "Code font", "SIL OFL 1.1",
                        "© 2020 The JetBrains Mono Project Authors") }}
                </tbody>
            </table>
        </div>
        <p class="small text-body-secondary mt-2">"QR Code" is a registered trademark of DENSO WAVE INCORPORATED.</p>
    </section>

    <section class="mt-5" aria-labelledby="credits-server">
        <h2 class="h4" id="credits-server">On the server</h2>
        <div class="table-responsive panel">
            <table class="table credits-table mb-0">
                <thead>
                    <tr><th scope="col">Project</th><th scope="col">Used for</th><th scope="col">Licence</th></tr>
                </thead>
                <tbody>
                    <tr><td><a href="https://rocket.rs/" target="_blank" rel="noopener noreferrer">Rocket</a> and rocket_dyn_templates</td><td>Web server and routing</td><td class="text-nowrap">MIT or Apache-2.0</td></tr>
                    <tr><td><a href="https://github.com/mitsuhiko/minijinja" target="_blank" rel="noopener noreferrer">MiniJinja</a></td><td>Page templates</td><td class="text-nowrap">Apache-2.0</td></tr>
                    <tr><td><a href="https://www.redb.org/" target="_blank" rel="noopener noreferrer">redb</a></td><td>Paste database</td><td class="text-nowrap">MIT or Apache-2.0</td></tr>
                    <tr><td><a href="https://github.com/spacejam/sled" target="_blank" rel="noopener noreferrer">sled</a></td><td>Importing the database used by older versions</td><td class="text-nowrap">MIT or Apache-2.0</td></tr>
                    <tr><td><a href="https://github.com/RustCrypto/hashes" target="_blank" rel="noopener noreferrer">sha2</a></td><td>Checking access proofs and delete links</td><td class="text-nowrap">MIT or Apache-2.0</td></tr>
                    <tr><td><a href="https://github.com/al8n/fs4-rs" target="_blank" rel="noopener noreferrer">fs4</a></td><td>Checking free disk space</td><td class="text-nowrap">MIT or Apache-2.0</td></tr>
                    <tr><td><a href="https://serde.rs/" target="_blank" rel="noopener noreferrer">serde</a> and serde_json</td><td>Reading and writing data</td><td class="text-nowrap">MIT or Apache-2.0</td></tr>
                    <tr><td><a href="https://github.com/chronotope/chrono" target="_blank" rel="noopener noreferrer">chrono</a></td><td>Dates and expiry times</td><td class="text-nowrap">MIT or Apache-2.0</td></tr>
                    <tr><td><a href="https://github.com/rust-random/rand" target="_blank" rel="noopener noreferrer">rand</a></td><td>Paste IDs</td><td class="text-nowrap">MIT or Apache-2.0</td></tr>
                </tbody>
            </table>
        </div>
        <p class="small text-body-secondary mt-2">Plus the Rust crates these depend on, listed in the project's
            <code>Cargo.lock</code>.</p>
    </section>

    <section class="mt-5" aria-labelledby="credits-build">
        <h2 class="h4" id="credits-build">Building the site</h2>
        <p class="text-body-secondary mb-0">The browser code is bundled with
            <a href="https://webpack.js.org/" target="_blank" rel="noopener noreferrer">webpack</a>, webpack-cli and
            compression-webpack-plugin (MIT).</p>
    </section>

