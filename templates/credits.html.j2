        <ul class="mt-3">
            <li>JetBrains Mono: <a href="/public/fonts/LICENSE-JetBrainsMono.txt">SIL Open Font License 1.1</a></li>
            <li>Metropolis: <a href="/public/fonts/LICENSE-Metropolis.txt">The Unlicense</a></li>
            <li>DOMPurify, MiniJinja and the Apache-2.0 option of the Rust crates:
                <a href="https://www.apache.org/licenses/LICENSE-2.0" target="_blank" rel="noopener noreferrer">Apache License 2.0</a></li>
        </ul>
    </section>
</div>
{% endblock %}
