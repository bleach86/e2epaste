# Copy to .env and edit. Read by docker compose.

# The site's public address, with https://
SITE_URL=https://paste.example.com

# The site's name, in page titles and the header. Empty: the host name.
SITE_NAME=

# What one paste can hold: text in KiB (1024 = 1 MB), whether attachments are
# allowed, and their size in MiB. A much larger MAX_PASTE_KIB needs a larger
# request size limit in your proxy (see README.md); attachments upload in
# 1 MiB chunks, so MAX_FILE_MIB doesn't.
MAX_PASTE_KIB=1024
ALLOW_FILES=true
MAX_FILE_MIB=25

# Port on 127.0.0.1 that the reverse proxy connects to.
PORT=8001

# Turns on the admin API for taking pastes down (see README.md). Leave empty
# to keep it off. Generate one with: openssl rand -hex 32
ADMIN_TOKEN=
