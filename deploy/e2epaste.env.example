# Settings for the e2epaste service: /etc/e2epaste/e2epaste.env, readable only
# by root and the service (deploy/install.sh sets that up). Any setting from
# Rocket.toml can go here as ROCKET_<NAME>; see README.md ("Configuration").
# After changing it: sudo systemctl restart e2epaste

# The site's public address, with https://.
ROCKET_SITE_URL=https://paste.example.com

# The name in page titles and the header. Empty: the address's host name.
ROCKET_SITE_NAME=

# Turns on the admin API for taking pastes down. Leave empty to keep it off.
# Generate one with: openssl rand -hex 32
ROCKET_ADMIN_TOKEN=

# Where the reverse proxy connects (the defaults in e2epaste.service).
#ROCKET_ADDRESS=127.0.0.1
#ROCKET_PORT=8001

# What one paste can hold.
#ROCKET_MAX_PASTE_KIB=1024
#ROCKET_ALLOW_FILES=true
#ROCKET_MAX_FILE_MIB=25
